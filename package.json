{
  "name": "uvld",
  "version": "1.1.0",
  "description": "Tiny, zero-dependency schema validation for JavaScript and TypeScript",
  "type": "module",
  "source": "./src/index.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "unpkg": "./dist/index.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs",
      "default": "./dist/utils.js"
    },
    "./package.json": "./package.json",
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js",
      "require": "./dist/async.cjs",
      "default": "./dist/async.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "utils.d.ts",
    "async.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "size": "node scripts/size.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "node examples/run-all.mjs",
    "check": "npm run typecheck && npm run test && npm run examples && npm run build && npm run size && npm run smoke",
    "prepack": "npm run build"
  },
  "keywords": [
    "validation",
    "validator",
    "schema",
    "typescript",
    "typescript-first",
    "tiny",
    "zero-dependency",
    "parse",
    "zod"
  ],
  "author": "Kethan Surana",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kethan/uvld.git"
  },
  "bugs": {
    "url": "https://github.com/kethan/uvld/issues"
  },
  "homepage": "https://github.com/kethan/uvld#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^22.0.0",
    "rollup": "^4.65.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
